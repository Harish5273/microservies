pipeline {
    agent any
    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = "${sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()}"
        ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        // CHANGE THIS line for each service (e.g., 'product-service', 'order-service'):
        SERVICE_NAME   = 'frontend'
        IMAGE_TAG      = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
    }
    stages {
        stage('Test & Lint') {
            steps {
                echo "===> Testing ${SERVICE_NAME}..."
                sh "python3 -m py_compile ${SERVICE_NAME}/app.py"
            }
        }
        stage('AWS ECR Login') {
            steps {
                sh 'aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}'
            }
        }
        stage('Build & Push Docker Image') {
            steps {
                echo "===> Building image for ${ECR_REGISTRY}/${SERVICE_NAME}..."
                

dir("${SERVICE_NAME}") {
                    sh 'docker build -t ${ECR_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG} -t ${ECR_REGISTRY}/${SERVICE_NAME}:latest .'
                    sh 'docker push ${ECR_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG}'
                    sh 'docker push ${ECR_REGISTRY}/${SERVICE_NAME}:latest'
                }
            }
        }
    }
    post {
        always {
            sh 'docker rmi ${ECR_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG} || true'
        }
    }
}